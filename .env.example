# ==============================================================================
# Personal Job Agent - Environment Configuration
# ==============================================================================

# Environment & Security
ENV=development
APP_PASSWORD=your_secure_password_at_least_12_chars
SESSION_SECRET=your_random_32_bytes_session_secret_here
DATABASE_URL=sqlite+aiosqlite:///data/jobs.db

# Server Configuration
PORT=8000
DEBUG=false
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=60
AUTO_TAILOR_HIGH_MATCH=true
MIN_MATCH_SCORE_NOTIFY=70

# LLM Inference Providers
# Options: "auto" (Groq <-> NVIDIA NIM auto-failover), "groq", or "nvidia"
LLM_PROVIDER=auto

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM Configuration
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Real-Time Instant Notification Channels
# 1. Telegram Bot (Instant push to phone)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 3. Slack Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 4. Email (SMTP)
EMAIL_NOTIFY_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

